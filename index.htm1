<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boxing Career</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #111;
            color: white;
            text-align: center;
        }

        .seite {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        h1 {
            font-size: 45px;
        }

        button {
            margin-top: 25px;
            padding: 15px 35px;
            font-size: 18px;
            font-weight: bold;
            border: none;
            border-radius: 10px;
            background: #e53935;
            color: white;
        }

        input, select {
            padding: 14px;
            margin: 8px;
            font-size: 17px;
            border-radius: 8px;
            border: none;
        }

        #boxerErstellen {
            display: none;
        }
    </style>
</head>

<body>

    <div id="startseite" class="seite">
        <h1>🥊 BOXING CAREER</h1>
        <p>Baue deine eigene Boxkarriere auf.</p>

        <button onclick="neueKarriere()">
            NEUE KARRIERE
        </button>
    </div>


    <div id="boxerErstellen" class="seite">
        <h1>👤 DEIN BOXER</h1>

        <input
            id="boxerName"
            type="text"
            placeholder="Name deines Boxers"
        >

        <select id="gewicht">
            <option>Leichtgewicht</option>
            <option>Weltergewicht</option>
            <option>Mittelgewicht</option>
            <option>Halbschwergewicht</option>
            <option>Schwergewicht</option>
        </select>

        <button onclick="boxerStarten()">
            KARRIERE STARTEN
        </button>
    </div>


    <script>

        function neueKarriere() {

            document.getElementById("startseite").style.display = "none";

            document.getElementById("boxerErstellen").style.display = "flex";

        }


        function boxerStarten() {

            let name = document.getElementById("boxerName").value;

            if (name === "") {
                alert("Gib zuerst einen Namen ein!");
                return;
            }

            alert("Willkommen " + name + "! 🥊");

        }

    </script>

</body>
</html>